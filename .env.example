# AgentPM environment (copy to .env — .env is gitignored, never commit keys)

# --- LLM provider (M44 real-model wiring) -------------------------------
# replay   : deterministic templates (CI/tests; no network)
# record   : real model + persist responses to data/fixtures/recordings.yaml
# openai   : real model (OpenAI SDK protocol or Anthropic messages protocol)
APM_PROVIDER_MODE=openai

# Any OpenAI-compatible endpoint works, e.g. Zhipu coding plan:
#   openai protocol:     https://open.bigmodel.cn/api/coding/paas/v4
#   anthropic protocol:  https://open.bigmodel.cn/api/anthropic
# Protocol is auto-detected from "/anthropic" in the base URL; override with
# APM_LLM_PROTOCOL=openai|anthropic when in doubt.
APM_LLM_API_BASE=https://open.bigmodel.cn/api/coding/paas/v4
APM_LLM_API_KEY=sk-...

# Reasoning models spend completion budget on invisible thinking — keep the
# ceiling generous or replies come back empty (finish_reason=length).
APM_LLM_MODEL=glm-5.3
APM_UI_AGENT_MODEL=glm-5.3-flash
APM_LLM_MAX_TOKENS=16384
APM_LLM_TIMEOUT_S=180

# --- storage / auth (optional overrides) ---------------------------------
# APM_DATA_DIR=data
# APM_AUTH_MODE=local
# APM_ADMIN_PASSWORD=

# --- webhook SSRF guard (M45-I137) ----------------------------------------
# Webhook delivery targets on loopback/private/link-local networks are rejected
# by default; set true only for test receivers or trusted intranet endpoints.
# APM_WEBHOOK_ALLOW_PRIVATE=false

# --- multi-currency (M46-I139) ---------------------------------------------
# Base currency for cost aggregation + manual FX table (auditable config, no
# live rates). 1 unit of X = value in the base currency.
# APM_BASE_CURRENCY=CNY
# APM_FX_RATES={"USD":7.2,"EUR":7.8}

# --- context compression (M47-I141) -----------------------------------------
# Char budget for the instruction+constraints block assembled into LLM prompts;
# early constraints fold into a one-line summary past the budget (read-path
# only — stored messages never change). 0 disables the limit.
# APM_CONTEXT_BUDGET_CHARS=8000

# --- model tiers (M48-I144) --------------------------------------------------
# Three-tier model names resolved from role YAML `model.tier: cheap|standard|
# reasoning` (an explicit model.name in the role still wins). STANDARD falls
# back to APM_LLM_MODEL; CHEAP falls back to APM_UI_AGENT_MODEL. On a main-tier
# failure (429/5xx/timeout) the engine retries ONCE on the next tier up and
# marks the span `apm.model_degraded` — never a silent swap on the happy path.
# APM_MODEL_CHEAP=glm-5.3-flash
# APM_MODEL_STANDARD=glm-5.3
# APM_MODEL_REASONING=glm-5.3
