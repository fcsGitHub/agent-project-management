{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "AgentPM 工作项生命周期（task 概念）",
    "locale": "zh-CN",
    "output": "item-lifecycle.html",
    "viewBox": [
      1080,
      640
    ],
    "quality_profile": "showcase",
    "views": [
      {
        "id": "main-rail",
        "label": "主链",
        "focus": [
          "triage",
          "open",
          "in_progress",
          "awaiting_review",
          "done"
        ],
        "note": "从分诊入列到验收完成的五个有序阶段。"
      },
      {
        "id": "wait-and-return",
        "label": "暂缓与复浮",
        "focus": [
          "triage",
          "snoozed"
        ],
        "note": "暂缓不终结工作项，sweep 到期把它送回队列。"
      },
      {
        "id": "exits",
        "label": "退出与回收",
        "focus": [
          "cancelled",
          "archived"
        ],
        "note": "取消是终态；归档是软删除，恢复后回到 open。"
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "主链"
    },
    {
      "id": "waiting",
      "label": "等待"
    },
    {
      "id": "terminal",
      "label": "终态与回收"
    }
  ],
  "states": [
    {
      "id": "triage",
      "type": "start",
      "label": "triage",
      "sublabel": "分诊队列（M117）",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "入列"
    },
    {
      "id": "open",
      "type": "active",
      "label": "open",
      "sublabel": "backlog（经 ready 就绪）",
      "lane": "main",
      "col": 1,
      "step": "02"
    },
    {
      "id": "in_progress",
      "type": "active",
      "label": "in_progress",
      "sublabel": "进行中",
      "lane": "main",
      "col": 2,
      "step": "03"
    },
    {
      "id": "awaiting_review",
      "type": "decision",
      "label": "awaiting_review",
      "sublabel": "待验收",
      "lane": "main",
      "col": 3,
      "step": "04"
    },
    {
      "id": "done",
      "type": "success",
      "label": "done",
      "sublabel": "关闭门禁 I78",
      "lane": "main",
      "col": 4,
      "step": "05",
      "tag": "终态"
    },
    {
      "id": "snoozed",
      "type": "waiting",
      "label": "snoozed",
      "sublabel": "snoozed_until · 1-30 天",
      "lane": "waiting",
      "col": 0,
      "tag": "暂缓"
    },
    {
      "id": "cancelled",
      "type": "failure",
      "label": "cancelled",
      "sublabel": "拒绝 / 中途取消",
      "lane": "terminal",
      "col": 0,
      "tag": "终态"
    },
    {
      "id": "archived",
      "type": "neutral",
      "label": "archived",
      "sublabel": "回收站 · 软删除",
      "lane": "terminal",
      "col": 1,
      "tag": "可恢复"
    }
  ],
  "transitions": [
    {
      "id": "accept",
      "from": "triage",
      "to": "open",
      "label": "接受（可带指派）",
      "variant": "emphasis",
      "route": "straight",
      "labelAt": [
        171,
        118
      ]
    },
    {
      "id": "start",
      "from": "open",
      "to": "in_progress",
      "label": "开工",
      "route": "straight"
    },
    {
      "id": "submit",
      "from": "in_progress",
      "to": "awaiting_review",
      "label": "提审",
      "route": "straight"
    },
    {
      "id": "verify",
      "from": "awaiting_review",
      "to": "done",
      "label": "验收",
      "route": "straight"
    },
    {
      "id": "snooze",
      "from": "triage",
      "to": "snoozed",
      "label": "暂缓",
      "route": "left-channel",
      "labelAt": [
        262,
        290
      ]
    },
    {
      "id": "decline",
      "from": "triage",
      "to": "cancelled",
      "label": "拒绝",
      "variant": "security",
      "route": "bottom-channel",
      "channelY": 400
    },
    {
      "id": "archive",
      "from": "open",
      "to": "archived",
      "label": "归档",
      "variant": "dashed",
      "route": "bottom-channel",
      "channelY": 240
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "主链",
      "items": [
        "五阶段一条主轨，triage 接受后落 open",
        "done 过关闭门禁：blocks 未完拒关（I78）"
      ]
    },
    {
      "dot": "amber",
      "title": "暂缓与复浮",
      "items": [
        "暂缓写 snoozed_until，不是终态",
        "sweep 到期复浮回 triage，幂等",
        "复浮项重新分诊：接受 / 再暂缓 / 拒绝"
      ]
    },
    {
      "dot": "rose",
      "title": "终态与回收",
      "items": [
        "cancelled 是终态，任意活态可取消",
        "archived 软删除：读面全对齐（M118）",
        "恢复回 open；bug 概念另有独立状态链"
      ]
    }
  ]
}
